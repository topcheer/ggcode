{
  "$schema": "https://github.com/GoogleChrome/lighthouse-ci/blob/main/docs/configuration.md",
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "http://127.0.0.1:4333/index.html",
        "http://127.0.0.1:4333/zh/index.html",
        "http://127.0.0.1:4333/privacy.html"
      ],
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "chromeFlags": [
          "--no-sandbox",
          "--proxy-server=direct://",
          "--proxy-bypass-list=*",
          "--disable-features=HttpsFirstBalancedModeAutoEnable"
        ]
      },
      "startServerCommand": "npm run preview -- --host 127.0.0.1 --port 4333",
      "startServerReadyPattern": "Local"
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500
              }
            ],
            "total-byte-weight": [
              "warn",
              {
                "maxNumericValue": 1200000
              }
            ],
            "render-blocking-resources": "warn",
            "unused-javascript": "warn",
            "unminified-javascript": "warn"
          }
        }
      ]
    }
  }
}
