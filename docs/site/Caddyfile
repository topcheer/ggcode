{
	admin off
	persist_config off
	auto_https off
}

# Site served by Caddy — static files from /srv

:{$PORT:80} {
	respond /health 200

	root * /srv

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	@html {
		path /
		path *.html
	}
	header @html Cache-Control "public, max-age=0, must-revalidate"

	@assets {
		path *.css *.js *.png *.svg *.jpg *.jpeg *.webp *.gif *.ico
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	encode {
		gzip
		zstd
	}

	# The release-asset mirror that used to live under /downloads/latest/ is retired;
	# keep old copies of the installers working by forwarding them to the Worker mirror
	# (workers/download-mirror, docs/release-process.md §5.6).
	@old_mirror path_regexp old_mirror ^/downloads/latest(\/.*)?$
	redir @old_mirror https://download.ggcode.dev/latest{re.old_mirror.1}{?query} 301

	try_files {path} {path}.html {path}/index.html
	file_server
}
