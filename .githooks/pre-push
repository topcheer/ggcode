#!/usr/bin/env bash
set -euo pipefail

if [[ "${GGCODE_SKIP_CI_HOOK:-0}" == "1" ]]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

# Check gofmt cleanliness (pinned to the go.mod toolchain, #5241).
# Exclude dot-dirs: gofmt -l . walks .ggcode/worktrees scratch copies that
# the Go tooling never builds; they are not part of the module.
unformatted=$("${repo_root}/scripts/dev/gofmt-pinned.sh" -l . 2>/dev/null | grep -v -E '^\.[a-zA-Z0-9_]+/' || true)
if [[ -n "${unformatted}" ]]; then
  echo "[pre-push] ERROR: unformatted files:"
  echo "${unformatted}"
  echo "Run: scripts/dev/gofmt-pinned.sh -w <files>"
  exit 1
fi

echo "[pre-push] running go vet"
go vet -tags goolm ./...

echo "[pre-push] running go build"
# 8+ ggcode instances share one GOCACHE; concurrent eviction corrupts
# entries and the build fails with cache-class errors ("not in std",
# "no such file or directory ... go-build") while the same tree builds
# fine on retry (#5251). Retry once against a fresh private cache
# instead of failing - never nuke the shared cache from a hook.
if ! CGO_ENABLED=0 go build -tags goolm -o /dev/null ./cmd/ggcode; then
  build_err=$(CGO_ENABLED=0 go build -tags goolm -o /dev/null ./cmd/ggcode 2>&1 || true)
  case "$build_err" in
    *"not in std"*|*go-build*)
      echo "[pre-push] cache-class build failure detected - retrying with a fresh private GOCACHE"
      CGO_ENABLED=0 GOCACHE="$(mktemp -d)" go build -tags goolm -o /dev/null ./cmd/ggcode
      ;;
    *)
      printf '%s\n' "$build_err"
      exit 1
      ;;
  esac
fi

echo "[pre-push] checks passed"
