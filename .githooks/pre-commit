#!/usr/bin/env bash
set -euo pipefail

if [[ "${GGCODE_SKIP_CI_HOOK:-0}" == "1" ]]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

# bash 3.2 (stock macOS /bin/bash) has no mapfile (a bash>=4 builtin) - use a
# portable read loop so the hook never deterministically fails on darwin (#5767).
staged_go_files=()
while IFS= read -r f; do
  [[ -n "${f}" ]] && staged_go_files+=("${f}")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
if ((${#staged_go_files[@]} > 0)); then
  echo "[pre-commit] formatting staged Go files (go.mod-pinned toolchain)"
  "${repo_root}/scripts/dev/gofmt-pinned.sh" -w "${staged_go_files[@]}"
  git add -- "${staged_go_files[@]}"
fi

# Quick checks only (no full test suite)
echo "[pre-commit] running go vet"
go vet -tags goolm ./...

echo "[pre-commit] running go build"
CGO_ENABLED=0 go build -tags goolm -o /dev/null ./cmd/ggcode
