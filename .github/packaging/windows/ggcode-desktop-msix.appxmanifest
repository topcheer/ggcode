<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 rescap">

  <!-- Template placeholders (injected by scripts/release/build-desktop-msix.ps1):
       {{IDENTITY_NAME}}  : Partner Center -> Product identity -> Package/Identity Name
       {{PUBLISHER}}      : Partner Center -> Product identity -> Publisher (CN=...)
       {{VERSION}}        : four-part package version, e.g. 1.3.268.0
       The first-time submission to the Store does NOT require a developer-signed
       package: Partner Center re-signs on ingestion. Keep the Identity values
       EXACTLY as shown in Partner Center or the upload is rejected. -->

  <Identity Name="{{IDENTITY_NAME}}"
            Publisher="{{PUBLISHER}}"
            Version="{{VERSION}}"
            ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <DisplayName>GGCode Desktop</DisplayName>
    <PublisherDisplayName>GG AI Studio</PublisherDisplayName>
    <Logo>Assets\Square150x150Logo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="GGCodeDesktop"
                 Executable="GGCode-Desktop.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="GGCode Desktop"
          Description="AI coding agent with desktop workflow"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
